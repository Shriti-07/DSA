//using two pointer
class Solution {
public:
    vector<int> unionArray(vector<int>& nums1, vector<int>& nums2) {
        vector<int> uni;
        int i=0,j=0;
        int n=nums1.size();
        int m=nums2.size();
        while (i < n && j < m) {
            if (nums1[i] < nums2[j]) {

                if (uni.empty() || uni.back() != nums1[i]){
                    uni.push_back(nums1[i]);
                }
                i++; 
            }
            else if (nums2[j] < nums1[i]) {
                if (uni.empty() || uni.back() != nums2[j]){
                    uni.push_back(nums2[j]);
                }
                j++;  
            }
            else {
                if (uni.empty() || uni.back() != nums1[i]){
                    uni.push_back(nums1[i]);
                }
                i++; 
                j++;  
            }
        }
        while (i < n) {
            if (uni.empty() || uni.back() != nums1[i]){
                uni.push_back(nums1[i]);
            }
            i++;
        }
        while (j < m) {
            if (uni.empty() || uni.back() != nums2[j])
                uni.push_back(nums2[j]);
            j++;
        }
        return uni;
    }
};

int main() {
    vector<int> arr1={1,2,2,8,5,21,67,9,33};
    vector<int> arr2={1,90,45,2,8,50,21};
    Solution sol;
    vector<int> uni=sol.unionArray(arr1,arr2);
    for(auto it: uni){
        cout<<it<<" ";
    }
    return 0;
}